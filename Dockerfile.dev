FROM rust:1-slim

# Debian slim images drop every man page, which makes `man` useless. The
# exclusion has to go before the pages can be installed.
RUN rm -f /etc/dpkg/dpkg.cfg.d/docker

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config git python3 less man-db manpages vim \
      netcat-openbsd iproute2 musl-tools \
    && apt-get install -y --reinstall --no-install-recommends coreutils \
    && rm -rf /var/lib/apt/lists/*

# Static release builds so the binary runs on the NixOS host unchanged, and the
# linters the suites expect.
RUN rustup target add x86_64-unknown-linux-musl \
    && rustup component add clippy rustfmt

WORKDIR /w
